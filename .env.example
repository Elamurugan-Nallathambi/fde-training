# Copy to .env and fill in. .env is ignored by git.
# Cloudflare account that owns the Pages project (wrangler whoami shows it).
CF_ACCOUNT_ID=
# Pages project name for ./setup.sh deploy.
CF_PROJECT=fde-training-program
# Optional: the Ask widget service the pages load (empty turns it off).
FDE_KB=https://quick-chat-program.pages.dev
# Optional: names that must not appear in generic content, comma separated (used by tools/check_*.py).
CONTENT_BANNED_TERMS=
